# ---------- Required ----------
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Frontend URL(s) allowed by CORS and Socket.IO, comma-separated, no trailing slash
FRONTEND_URL=http://localhost:3000

# ---------- AI ----------
# Create the key in Google AI Studio. New keys are "auth keys"; old unrestricted
# standard keys are rejected by the Gemini API.
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768        # changing this requires: npm run setup:rag -- --purge
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=3
# RAG_MIN_SCORE=0.5
# RAG_MAX_CHUNKS=2000

# ---------- Email (OTP) ----------
# Option A (recommended, required on Render's free plan): Brevo HTTP API.
#   Brevo → SMTP & API → API keys, permission "Transactional email: All".
BREVO_API_KEY=
# Sender shown on the email. EMAIL_FROM must be a verified sender in Brevo.
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=NowledgeHub

# Option B: SMTP with Nodemailer (used only when BREVO_API_KEY is empty).
# Gmail needs an App Password. Render's free plan blocks SMTP ports.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# Number of proxies in front of the app (Render = 1)
# TRUST_PROXY=1
